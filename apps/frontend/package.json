{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev -p 3000",
    "dev:fresh": "node -e \"const fs=require('fs');try{if(fs.existsSync('.next'))fs.rmSync('.next',{recursive:true,force:true});}catch(e){console.error(e);process.exit(1)}\" && cross-env NODE_ENV=development next dev -p 3000",
    "build:challenges": "pnpm --filter @code-legends/challenges run build",
    "build:shared-types": "pnpm --filter @code-legends/shared-types run build",
    "build:video-providers": "pnpm --filter @code-legends/video-providers run build",
    "build:plans": "pnpm --filter @code-legends/plans run build",
    "build": "pnpm run build:shared-types && pnpm run build:challenges && pnpm run build:video-providers && pnpm run build:plans && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "test": "vitest run --dir src/lib",
    "test:watch": "vitest --dir src/lib",
    "analyze": "cross-env ANALYZE=true next build",
    "server": "json-server --watch db.json --port 3001",
    "prepare": "husky"
  },
  "dependencies": {
    "@code-legends/challenges": "workspace:*",
    "@code-legends/shared-types": "workspace:*",
    "@code-legends/video-providers": "workspace:*",
    "@code-legends/plans": "workspace:*",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@hookform/resolvers": "^3.9.1",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/typography": "^0.5.19",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.29.2",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.474.0",
    "next": "15.2.8",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.0.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwind-scrollbar-hide": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "3.21.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "15.2.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "^3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.24",
    "cross-env": "^7.0.3",
    "json-server": "^1.0.0-beta.3",
    "eslint": "^9",
    "eslint-config-next": "15.2.8",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "0.33.0"
  }
}