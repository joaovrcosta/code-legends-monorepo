generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Course {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  active        Boolean      @default(true)
  thumbnail     String?
  colorHex      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  releaseAt     DateTime?    @default(now())
  isFree        Boolean      @default(false)
  subscriptions Int          @default(0)
  level         String
  icon          String?
  description   String
  status        CourseStatus @default(DRAFT)
  publishedAt   DateTime?

  instructorId String
  instructor   User   @relation("CourseInstructor", fields: [instructorId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  tags Tag[] @relation("CourseToTag")

  modules         Module[]
  userCourses     UserCourse[]
  Certificate     Certificate[]
  favoriteCourses FavoriteCourse[]
  activeUsers     User[]           @relation("ActiveCourse")
  skills          CourseSkill[]
}

model Tag {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[] @relation("CourseToTag")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model Plan {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  colorHex    String?
  amountCents Int      @default(0)
  order       Int      @default(0)
  active      Boolean  @default(true)
  externalId  String?
  productName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                              String        @id @default(cuid())
  email                           String        @unique
  name                            String
  password                        String?
  googleId                        String?       @unique
  avatar                          String?
  slug                            String?       @unique
  bio                             String?
  createdAt                       DateTime      @default(now())
  updatedAt                       DateTime      @updatedAt
  birth_date                      DateTime?
  born_in                         String?
  document                        String?
  foreign_phone                   String?
  fullname                        String?
  gender                          String?
  marital_status                  MaritalStatus @default(SINGLE)
  role                            Role          @default(STUDENT)
  plan                            UserPlan      @default(FREE)
  occupation                      String?
  phone                           String?
  rg                              String?
  onboardingCompleted             Boolean       @default(false)
  onboardingGoal                  String?
  onboardingCareer                String?
  totalXp                         Int           @default(0)
  level                           Int           @default(1)
  xpToNextLevel                   Int           @default(100)
  lastLogin                       DateTime?
  postPurchaseWelcomeAckPaymentId String?

  expertise Expertise[] @relation("UserToExpertise")

  Address             Address?
  userCourses         UserCourse[]
  userProgress        UserProgress[]
  Certificate         Certificate[]
  favoriteCourses     FavoriteCourse[]
  activeCourseId      String?
  activeCourse        Course?              @relation("ActiveCourse", fields: [activeCourseId], references: [id])
  coursesAsInstructor Course[]             @relation("CourseInstructor")
  lessonsAsAuthor     Lesson[]             @relation("LessonAuthor")
  xpHistory           UserXpHistory[]
  skillXp             UserSkillXp[]
  skillXpHistory      UserSkillXpHistory[]
  xpEvents            UserXpEvent[]
  streak              UserStreak?
  requests            Request[]
  notifications       Notification[]
  payments            Payment[]
  subscriptions       Subscription[]
  lessonProductionsUpdated LessonProduction[] @relation("LessonProductionUpdatedBy")
  lessonProductionLogs LessonProductionLog[] @relation("LessonProductionLogActor")
}

model UserStreak {
  userId          String   @id
  currentStreak   Int      @default(0)
  bestStreak      Int      @default(0)
  totalActiveDays Int      @default(0)
  /// Último dia ativo no fuso America/Sao_Paulo, formato YYYY-MM-DD
  lastActiveDate  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastActiveDate])
}

model Expertise {
  id    String @id @default(cuid())
  name  String @unique
  users User[] @relation("UserToExpertise")
}

model Module {
  id                 String               @id @default(cuid())
  title              String
  slug               String
  courseId           String
  orderIndex         Int                  @default(0)
  course             Course               @relation(fields: [courseId], references: [id])
  submodules         Submodule[]
  userCourses        UserCourse[]
  userModuleProgress UserModuleProgress[]
  unlockedModules    UnlockedModule[]

  @@unique([slug, courseId])
}

model Submodule {
  id         Int      @id @default(autoincrement())
  title      String
  moduleId   String
  orderIndex Int      @default(0)
  module     Module   @relation(fields: [moduleId], references: [id])
  lessons    Lesson[]

  @@map("Group")
}

model Lesson {
  id             Int            @id @default(autoincrement())
  title          String
  description    String
  type           LessonType
  slug           String
  url            String?
  isFree         Boolean        @default(false)
  video_url      String?
  video_duration String?
  locked         Boolean        @default(false)
  completed      Boolean        @default(false)
  completedAt    DateTime?
  submoduleId    Int
  order          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  authorId       String
  author         User           @relation("LessonAuthor", fields: [authorId], references: [id])
  submodule      Submodule      @relation(fields: [submoduleId], references: [id])
  userCourses    UserCourse[]
  userProgress   UserProgress[]

  video   Video?
  article Article?
  quiz    Quiz?
  project Project?
  skills  LessonSkill[]
  production LessonProduction?
  productionLogs LessonProductionLog[]

  @@unique([slug, submoduleId])
}

enum LessonProductionStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

model LessonProduction {
  id          String                @id @default(cuid())
  lessonId    Int                   @unique
  lesson      Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      LessonProductionStatus @default(TODO)
  notes       String?               @db.Text
  updatedById String
  updatedBy   User                  @relation("LessonProductionUpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status])
  @@index([updatedAt])
}

model LessonProductionLog {
  id         String                @id @default(cuid())
  lessonId   Int
  lesson     Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId   String
  fromStatus LessonProductionStatus
  toStatus   LessonProductionStatus
  actorId    String
  actor      User                  @relation("LessonProductionLogActor", fields: [actorId], references: [id], onDelete: Cascade)
  createdAt  DateTime              @default(now())

  @@index([courseId, createdAt(sort: Desc)])
  @@index([lessonId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

enum LessonType {
  VIDEO      @map("video")
  ARTICLE    @map("article")
  TEXT       @map("text")
  QUIZ       @map("quiz")
  MULTI_QUIZ @map("multi_quiz")
  PROJECT    @map("project")
}

model Video {
  id        String   @id @default(cuid())
  url       String?
  duration  String?
  lessonId  Int      @unique
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id        String   @id @default(cuid())
  body      String   @db.Text
  lessonId  Int      @unique
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quiz {
  id        String   @id @default(cuid())
  lessonId  Int      @unique
  content   Json?
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  description String   @db.Text
  lessonId    Int      @unique
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  badgeId     String?
  specs       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// URL pública opcional (ícone/imagem da skill, análogo ao avatar do usuário)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses CourseSkill[]
  lessons LessonSkill[]
  users   UserSkillXp[]
  xpLog   UserSkillXpHistory[]
}

model CourseSkill {
  id       String @id @default(cuid())
  courseId String
  skillId  String
  weight   Int

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([courseId, skillId])
}

model LessonSkill {
  id       String @id @default(cuid())
  lessonId Int
  skillId  String
  weight   Int

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([lessonId, skillId])
  @@index([lessonId])
}

model UserSkillXp {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  xp        Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

model UserSkillXpHistory {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  xpAmount    Int
  source      String
  sourceId    Int?
  description String?
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model UserCourse {
  id                 String               @id @default(cuid())
  userId             String
  courseId           String
  enrolledAt         DateTime             @default(now())
  lastAccessedAt     DateTime             @default(now())
  isCompleted        Boolean              @default(false)
  completedAt        DateTime?
  currentModuleId    String?
  currentTaskId      Int?
  progress           Float                @default(0.0)
  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  currentModule      Module?              @relation(fields: [currentModuleId], references: [id])
  currentTask        Lesson?              @relation(fields: [currentTaskId], references: [id])
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userModuleProgress UserModuleProgress[]
  userProgress       UserProgress[]
  unlockedModules    UnlockedModule[]

  @@unique([userId, courseId])
}

model UserProgress {
  id           String     @id @default(cuid())
  userId       String
  taskId       Int
  userCourseId String
  isCompleted  Boolean    @default(false)
  completedAt  DateTime?
  timeSpent    Int        @default(0)
  lastPosition Int?
  attempts     Int        @default(0)
  score        Float?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  task         Lesson     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userCourse   UserCourse @relation(fields: [userCourseId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

model UserModuleProgress {
  id             String     @id @default(cuid())
  userId         String
  moduleId       String
  userCourseId   String
  isCompleted    Boolean    @default(false)
  completedAt    DateTime?
  progress       Float      @default(0.0)
  tasksCompleted Int        @default(0)
  totalTasks     Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  module         Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userCourse     UserCourse @relation(fields: [userCourseId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model UnlockedModule {
  id           String     @id @default(cuid())
  userId       String
  moduleId     String
  userCourseId String
  unlockedAt   DateTime   @default(now())
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  userCourse   UserCourse @relation(fields: [userCourseId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, userCourseId])
}

model Address {
  id              String  @id @default(cuid())
  userId          String  @unique
  country         String?
  foreign_country Boolean @default(false)
  postal_code     String?
  street_name     String?
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  foreign_address String?
  User            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certificate {
  id         String               @id @default(cuid())
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  templateId String?
  template   CertificateTemplate? @relation(fields: [templateId], references: [id])
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
}

model CertificateTemplate {
  id           String        @id @default(cuid())
  name         String
  description  String
  certificates Certificate[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model FavoriteCourse {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model UserXpHistory {
  id          String   @id @default(cuid())
  userId      String
  xpAmount    Int
  source      String
  sourceId    Int?
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model UserXpEvent {
  id        String   @id @default(cuid())
  userId    String
  reasonId  String
  source    String
  sourceId  Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reasonId])
  @@index([userId, createdAt])
}

model Request {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  status      RequestStatus @default(PENDING)
  title       String?
  description String?
  data        String?
  response    String?
  respondedBy String?
  respondedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([status])
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum Role {
  INSTRUCTOR
  ADMIN
  STUDENT
}

enum UserPlan {
  FREE
  PRO
  PREMIUM
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
}

enum CourseStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum NotificationType {
  NEW_COURSE_AVAILABLE
  CERTIFICATE_GENERATED
  LEVEL_UP
  REQUEST_STATUS_CHANGED
  COURSE_COMPLETED
  NEW_EVENT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([type])
}

model Payment {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents      Int
  currency         String        @default("BRL")
  status           PaymentStatus @default(PENDING)
  plan             UserPlan
  gateway          String
  gatewayPaymentId String?
  metadata         Json?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([gatewayPaymentId])
  @@index([userId, status, createdAt(sort: Desc)])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  UserPlan
  status                SubscriptionStatus @default(ACTIVE)
  startsAt              DateTime
  endsAt                DateTime
  gatewaySubscriptionId String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([endsAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
