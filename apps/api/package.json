{
  "name": "@code-legends/api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build:challenges": "pnpm --filter @code-legends/challenges run build",
    "build:shared-types": "pnpm --filter @code-legends/shared-types run build",
    "build:video-providers": "pnpm --filter @code-legends/video-providers run build",
    "build:payment-providers": "pnpm --filter @code-legends/payment-providers run build",
    "build:plans": "pnpm --filter @code-legends/plans run build",
    "build": "prisma generate && pnpm run build:shared-types && pnpm run build:challenges && pnpm run build:video-providers && pnpm run build:payment-providers && pnpm run build:plans && tsup src",
    "start": "node dist/server.js",
    "test": "vitest run --dir src/use-cases",
    "test:watch": "vitest --dir src/use-cases",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --dir src/http",
    "test:ui": "vitest --ui",
    "backfill:xp-cache": "tsx prisma/backfill-xp-cache.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:payment-providers": "tsx prisma/scripts/seed-payment-providers.ts",
    "postinstall": "prisma generate || node -e \"process.exit(0)\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "2.4.2",
    "@types/node": "^20.4.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "0.33.0",
    "npm-run-all": "4.1.5",
    "prisma": "6.4.0",
    "supertest": "^7.2.2",
    "tsup": "8.0.1",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6",
    "vite-tsconfig-paths": "4.2.0",
    "vitest": "0.33.0"
  },
  "dependencies": {
    "@code-legends/challenges": "workspace:*",
    "@code-legends/shared-types": "workspace:*",
    "@code-legends/payment-providers": "workspace:*",
    "@code-legends/plans": "workspace:*",
    "@code-legends/video-providers": "workspace:*",
    "@fastify/cookie": "8.3.0",
    "@fastify/cors": "8.3.0",
    "@fastify/jwt": "7.2.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "6.4.0",
    "bcryptjs": "2.4.3",
    "cheerio": "1.0.0-rc.12",
    "dotenv": "16.3.1",
    "fastify": "^4.19.2",
    "pg": "8.11.3",
    "zod": "3.21.4"
  }
}