{
  "name": "@code-legends/challenges",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./src/editor-meta.ts",
      "import": "./src/editor-meta.ts",
      "require": "./dist/editor-meta.js",
      "default": "./dist/editor-meta.js"
    },
    "./slots": {
      "types": "./src/slots/index.ts",
      "import": "./src/slots/index.ts",
      "require": "./dist/slots/index.js",
      "default": "./dist/slots/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@code-legends/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.1.6",
    "vitest": "0.33.0"
  }
}
